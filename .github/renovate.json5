{
    $schema: 'https://docs.renovatebot.com/renovate-schema.json',
    extends: [
        'config:recommended',
        'docker:enableMajor',
        ':disableRateLimiting',
        ':dependencyDashboard',
        ':semanticCommits',
        ':automergeDigest',
        ':automergeBranch',
        'github>pregister/openshift//.github/renovate/allowedVersions.json5',
        'github>pregister/openshift//.github/renovate/autoMerge.json5',
        'github>pregister/openshift//.github/renovate/commitMessage.json5',
        'github>pregister/openshift//.github/renovate/groups.json5',
        'github>pregister/openshift//.github/renovate/labels.json5',
        'github>pregister/openshift//.github/renovate/semanticCommits.json5',
        'helpers:pinGitHubActionDigests',
    ],
    dependencyDashboardTitle: 'Renovate Dashboard',
    suppressNotifications: [
        'prIgnoreNotification',
    ],
    ignorePaths: [
        '**/archive/**',
        'charts/media-application/values.yaml',
    ],
    ignoreDeps: [
      "registry.connect.redhat.com/intel/intel-gpu-plugin",
      "registry.redhat.io/openshift4/ose-node-feature-discovery-rhel9",
      "registry.redhat.io/openshift4/ose-cli",
    ],
    timezone: 'America/New_York',
    // The marquee and episodic charts are private packages on ghcr.io.
    // Renovate's login for them is a host rule kept in the Renovate app's
    // settings for this repository, not here.
    packageRules: [
        {
            description: 'The marquee and episodic charts: every new version is committed to the branch, with no pull request',
            matchDatasources: ['docker'],
            matchPackageNames: ['ghcr.io/ullbergm/charts/**'],
            automerge: true,
            automergeType: 'branch',
            ignoreTests: true,
            commitMessageTopic: 'chart {{depName}}',
            semanticCommitScope: 'register-custom',
            addLabels: ['renovate/helm'],
        },
    ],
    registryAliases: {
        'bjw-s': 'https://bjw-s-labs.github.io/helm-charts',
    },
    customManagers: [
        {
            customType: 'regex',
            datasourceTemplate: 'docker',
            description: 'Update container versions in yaml',
            managerFilePatterns: [
                '/(^|/)[^\\.]*\\.ya?ml$/',
            ],
            matchStrings: [
                '#\\s?renovate custom-docker\\s?(?: versioning=(?<versioning>[a-z-]+?))?\\s*- name:.*\\s*value:\\s?(?<depName>[.\\w\\d-/]+)\\s*- name:.*\\s*value:\\s?(?<currentValue>[.\\w\\d-]+)',
            ],
        },
        {
            customType: 'regex',
            description: 'Update the chart version of an Argo CD Application that takes its chart from an OCI registry',
            managerFilePatterns: [
                '/(^|/)[^\\.]*\\.ya?ml$/',
            ],
            matchStrings: [
                '#\\s?renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)\\s+targetRevision:\\s?(?<currentValue>\\S+)',
            ],
            versioningTemplate: 'semver',
        },
    ],
    enabledManagers: [
        'github-actions',
        'custom.regex',
        'helmv3',
        'helm-values',
    ],
}
